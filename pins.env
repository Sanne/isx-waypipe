# What isx-waypipe builds. Both ends of a waypipe connection must be the same version, so the
# Linux and macOS binaries are built from one upstream release.
#
# A commit ID names the source exactly, whoever serves it.

# Upstream waypipe (GPL-3.0-or-later): the Linux binaries are built from it unmodified.
WAYPIPE_VERSION=0.11.2
WAYPIPE_REPO=https://gitlab.freedesktop.org/mstoeckl/waypipe.git
WAYPIPE_COMMIT=a1ffdd8d0f44cbdb25a3edd1c6adc0a30cfcf754

# waypipe-darwin (GPL-3.0-or-later): upstream at WAYPIPE_COMMIT plus the macOS port, two commits.
# The macOS binary is built from it, since upstream does not build on macOS.
DARWIN_TAG=v0.11.2-darwin.1
DARWIN_REPO=https://github.com/J-x-Z/waypipe-darwin.git
DARWIN_COMMIT=d896adccb624b363151aa350177c8193863ade81

# The Alpine release the Linux binaries are built in, for its musl toolchain and static libraries.
# Each sum is the minirootfs's own, as incus-spawn's appliance/build.sh pins it from the release's
# signed .sha256 file.
ALPINE_VERSION=3.24.4
ALPINE_SHA256_x86_64=cdaa38cb8de3537967ee5b6c9b6cd00cc962da2b018e6eea48696bb274923012
ALPINE_SHA256_aarch64=4b14c18f7e90a063b61462ea1462a5732c154bf6adad594974fe6487cd98a8de
